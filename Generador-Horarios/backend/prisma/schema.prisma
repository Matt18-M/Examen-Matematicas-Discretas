generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id            Int      @id @default(autoincrement())
  name          String
  parallel      String   @default("A")
  day           String
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  modality      String
  difficulty    String
  credits       Int
  prerequisites String[] @default([])

  @@map("courses")
}

model ScheduleConfig {
  id                      Int      @id @default(autoincrement())
  numberOfCourses         Int      @map("number_of_courses")
  maximumCredits          Int      @map("maximum_credits")
  maximumDifficultCourses Int      @map("maximum_difficult_courses")
  requiredCourses         String[] @map("required_courses")
  requiredModality        String   @map("required_modality")
  avoidTimeConflicts      Boolean  @default(true) @map("avoid_time_conflicts")
  validatePrerequisites   Boolean  @default(true) @map("validate_prerequisites")

  @@map("schedule_config")
}